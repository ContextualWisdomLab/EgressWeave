{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EgressWeave decision evidence v1",
  "description": "Privacy-minimized deterministic evidence for one successfully authorized EgressWeave authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "allowed_methods",
    "address_count",
    "ipv4_address_count",
    "ipv6_address_count",
    "policy_fingerprint",
    "decision_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "egressweave.decision-evidence.v1"
    },
    "authority": {
      "type": "string",
      "minLength": 3,
      "maxLength": 259,
      "pattern": "^(?=.{1,253}:)(?![0-9.]+:)(?!0x[0-9a-f]+:)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "allowed_methods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Z-]+$",
        "not": {
          "const": "CONNECT"
        }
      }
    },
    "address_count": {
      "type": "integer",
      "minimum": 1
    },
    "ipv4_address_count": {
      "type": "integer",
      "minimum": 0
    },
    "ipv6_address_count": {
      "type": "integer",
      "minimum": 0
    },
    "policy_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
